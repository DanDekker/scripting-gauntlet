# Standard system accounts
root:x:0:0:root:/root:/bin/bash
daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin
bin:x:2:2:bin:/bin:/usr/sbin/nologin
sys:x:3:3:sys:/dev:/usr/sbin/nologin
sync:x:4:65534:sync:/bin:/bin/sync

# Duplicate UID (toor has uid 0 -> ROOT_EQUIV and DUPLICATE_UID)
toor:x:0:0:toor alternate:/root:/bin/bash

# Duplicate UID non-root (shared UID 1001 between alice and bob)
alice:x:1001:1001:Alice Smith:/home/alice:/bin/bash
bob:x:1001:1002:Bob Jones:/home/bob:/bin/zsh

# Orphan GID: gid 9999 does not exist in in/group
ghost:x:1003:9999:Ghost User:/home/ghost:/bin/false

# Normal user
charlie:x:1004:1004:Charlie Brown:/home/charlie:/bin/bash
