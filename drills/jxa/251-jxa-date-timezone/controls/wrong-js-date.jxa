#!/usr/bin/env osascript -l JavaScript
ObjC.import('Foundation');
function env(name) {
  const value = $.NSProcessInfo.processInfo.environment.objectForKey($(name));
  if (!value) throw new Error(name + ' is missing');
  return ObjC.unwrap(value);
}
function write(path, text) {
  const error = Ref();
  $(text).writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, error);
}
const parser = $.NSDateFormatter.alloc.init;
parser.locale = $.NSLocale.localeWithLocaleIdentifier($('en_US_POSIX'));
parser.dateFormat = $('yyyy-MM-dd\'T\'HH:mm:ssXXXXX');
// BUG: NSDateFormatter is lenient by default, so 2026-02-29 rolls into March.
const utc = $.NSDateFormatter.alloc.init;
utc.locale = $.NSLocale.localeWithLocaleIdentifier($('en_US_POSIX'));
utc.dateFormat = $('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
utc.timeZone = $.NSTimeZone.timeZoneForSecondsFromGMT(0);
const source = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(
  $(env('IN') + '/stamps.csv'), $.NSUTF8StringEncoding, Ref(),
));
const rows = [];
for (const line of source.split(/\r\n|\r|\n/).slice(1)) {
  if (!line.trim()) continue;
  const parts = line.split(',');
  const date = parser.dateFromString($(parts.slice(1).join(',').trim()));
  if (!date) continue;
  rows.push([parts[0], ObjC.unwrap(utc.stringFromDate(date)), Number(date.timeIntervalSince1970)]);
}
write(env('OUT') + '/stamps.csv', ['id,utc,epoch'].concat(rows.map((row) => row.join(','))).join('\n') + '\n');
write(env('OUT') + '/summary.json', JSON.stringify({accepted:rows.length,rejected:0,epoch_zero:1}) + '\n');
