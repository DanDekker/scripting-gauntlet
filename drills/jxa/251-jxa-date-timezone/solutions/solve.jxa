#!/usr/bin/env osascript -l JavaScript
ObjC.import('Foundation');

function env(name) {
  const value = $.NSProcessInfo.processInfo.environment.objectForKey($(name));
  if (!value) throw new Error(name + ' is missing');
  return ObjC.unwrap(value);
}

function writeText(path, text) {
  const error = Ref();
  if (!$(text).writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, error)) {
    throw new Error('cannot write ' + path);
  }
}

function csvCell(value) {
  return '"' + String(value).replace(/"/g, '""') + '"';
}

const input = env('IN');
const output = env('OUT');
const parser = $.NSDateFormatter.alloc.init;
parser.locale = $.NSLocale.localeWithLocaleIdentifier($('en_US_POSIX'));
parser.dateFormat = $('yyyy-MM-dd\'T\'HH:mm:ssXXXXX');
parser.lenient = false;
const utcFormatter = $.NSDateFormatter.alloc.init;
utcFormatter.locale = $.NSLocale.localeWithLocaleIdentifier($('en_US_POSIX'));
utcFormatter.dateFormat = $('yyyy-MM-dd\'T\'HH:mm:ss\'Z\'');
utcFormatter.timeZone = $.NSTimeZone.timeZoneForSecondsFromGMT(0);

const rows = [];
let rejected = 0;
let epochZero = 0;
const source = $.NSString.stringWithContentsOfFileEncodingError(
  $(input + '/stamps.csv'), $.NSUTF8StringEncoding, Ref(),
);
for (const line of ObjC.unwrap(source).split(/\r\n|\r|\n/).slice(1)) {
  if (!line.trim()) continue;
  const parts = line.split(',');
  const id = parts[0].trim();
  const stamp = parts.slice(1).join(',').trim();
  const date = parser.dateFromString($(stamp));
  if (!date || ObjC.unwrap(parser.getObjectValueForStringRangeError(date, $(stamp), null, null)) === false) {
    rejected++;
    continue;
  }
  const epoch = Number(date.timeIntervalSince1970);
  if (epoch === 0) epochZero++;
  rows.push([id, ObjC.unwrap(utcFormatter.stringFromDate(date)), epoch]);
}

const csv = ['id,utc,epoch']
  .concat(rows.map((row) => row.map(csvCell).join(','))).join('\n') + '\n';
writeText(output + '/stamps.csv', csv);
writeText(output + '/summary.json', JSON.stringify({
  accepted: rows.length, rejected, epoch_zero: epochZero,
}) + '\n');
