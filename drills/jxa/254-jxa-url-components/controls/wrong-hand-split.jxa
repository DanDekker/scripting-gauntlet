#!/usr/bin/env osascript -l JavaScript
ObjC.import('Foundation');
function env(name) {
  const value = $.NSProcessInfo.processInfo.environment.objectForKey($(name));
  if (!value) throw new Error(name + ' is missing');
  return ObjC.unwrap(value);
}
function write(path, text) {
  const error = Ref();
  $(text).writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, error);
}
const source = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(
  $(env('IN') + '/urls.csv'), $.NSUTF8StringEncoding, Ref(),
));
const rows = [];
for (const line of source.split(/\r\n|\r|\n/).slice(1)) {
  if (!line.trim()) continue;
  const comma = line.indexOf(',');
  const id = line.slice(0, comma);
  const raw = line.slice(comma + 1);
  if (!raw.includes('://') && !raw.startsWith('file:')) continue;
  const scheme = raw.split(':')[0];
  const rest = raw.replace(/^[^:]+:\/\//, '');
  const authority = rest.split('/')[0];
  const hostParts = authority.split(':');
  const host = hostParts[0];
  const port = hostParts[1] || '';
  const path = '/' + rest.split('/').slice(1).join('/').split('?')[0];
  const query = raw.includes('?') ? raw.split('?')[1].split('&').filter(Boolean).length : 0;
  rows.push([id, scheme, host, port, path, query]);
}
write(env('OUT') + '/urls.csv', ['id,scheme,host,port,path,query_items'].concat(rows.map((row) => row.join(','))).join('\n') + '\n');
write(env('OUT') + '/summary.json', JSON.stringify({urls:rows.length,skipped:1,query_params:2}) + '\n');
